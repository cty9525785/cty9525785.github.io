[3:v]crop=960:320:690:470,setpts=(PTS-STARTPTS)/2,scale=480:156,fps=30,format=yuv420p,settb=AVTB[b];
[4:v]crop=780:260:0:380,setpts=(PTS-STARTPTS)/2,scale=480:156,fps=30,format=yuv420p,settb=AVTB[c];
color=c=white:s=480x6:r=30:d=5.6,format=yuv420p,settb=AVTB[g1];
